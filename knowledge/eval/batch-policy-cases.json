    "expectMeaning": {"column": "温差", "code": "-9", "meaning": "valid"},
    "attempt": {"action": "set_code_missing", "column": "温差", "code": "-9", "blocked": true}
  },
  {
    "id": "fabricated-check-never-enables-cleaning",
