# 依赖
node_modules/
.pnpm-store/

# 构建产物
.next/
out/
dist/
build/

# 环境变量（严禁提交）
.env
.env.local
.env.*.local
*.env.local

# 测试与覆盖率
coverage/
playwright-report/
test-results/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 临时文件
*.tmp
.tmp/
tmp/

# SDD 执行工作区（临时台账与简报）
.superpowers/

# TypeScript 增量构建缓存
tsconfig.tsbuildinfo
*.tsbuildinfo

# Python 字节码缓存（knowledge/tools 下的脚本是独立工具链）
__pycache__/
*.pyc

# Office 锁文件。打开 Excel / WPS 时会生成，内容无意义且每次不同。
# 曾经因为缺这条规则，knowledge/~$知识库模板.xlsx 差点被 git add -A 带进仓库。
~$*

# 知识库模板的时点备份。模板本身已在 git 里逐版本保存，再存一份二进制是冗余，
# 而且每备份一次就给仓库永久增加 25–60 KB。
knowledge/知识库模板-*备份-*.xlsx

# 规则索引的前端副本。它由 `scripts/sync-rules.mjs` 从 knowledge/index/rules.json
# 拷过来（predev / prebuild 自动跑）。真源在 knowledge/ 下，这份是产物，不进版本控制
# —— 否则每改一条规则就要往仓库里塞 900 KB 的 diff。
public/knowledge/

# 评测结论的前端副本。同理，由 `scripts/sync-eval.mjs` 从 knowledge/reports/eval-*.json
# 拷过来。真源在那几份 JSON 里（它们由评测脚本产出），这份是产物。
# 与规则索引不同的是：**真源要入库** —— 评测数字是「系统判断得准不准」的依据，
# 看板要能显示它，而看板不能依赖「跑过评测的机器」。
public/eval/
