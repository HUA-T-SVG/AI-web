# 复制本文件为 .env.local 并填入真实值。
# .env.local 已在 .gitignore 中，不会提交到仓库。
#
# 环境变量只用于服务端，不要加 NEXT_PUBLIC_ 前缀 —— 那会把它打进
# 客户端打包产物，等于把密钥公开。公开仓库不得包含任何密钥。

# 大模型 API 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：/api/agent 的实例级限流（默认 240 次 / 5 分钟 / 访客）。
# 只防误刷与爬虫 —— Serverless 多实例各算各的，硬配额要靠外部存储。
# AGENT_RATE_LIMIT_MAX=240
# AGENT_RATE_LIMIT_WINDOW_MS=300000
